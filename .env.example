# Copy this file to .env for local work. Never commit real values.
DATABASE_URL=postgres://user:password@host/database
PAYLOAD_SECRET=replace-with-a-long-random-value
NEXT_PUBLIC_SITE_URL=https://example.com

# Creates the first dashboard login on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Image storage for the dashboard on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional: email alerts for new enquiries.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=

# Optional: extra spam protection on the enquiry form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
